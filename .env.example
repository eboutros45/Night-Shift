# Copy to .env. DATABASE_URL is required; migrate the database before starting.

PORT=3000
# Public base URL used in ticket links and "emails".
APP_URL="http://localhost:3000"
# PostgreSQL connection string. Use a separate development database.
DATABASE_URL="postgresql://postgres:password@localhost:5432/nightshift"
# Optional locally; required in the Worker. Never expose the secret key to browsers.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Local upload fallback when SUPABASE_URL is empty.
STORAGE_DIR=storage

# 32+ random bytes. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="dev-only-change-me-dev-only-change-me"

# Minutes an unpaid reservation is held.
RESERVATION_MINUTES=30

# Manual Whish Money payment details shown to buyers (no API is called).
WHISH_PAYMENT_LINK="https://example.com/whish-placeholder"
WHISH_ACCOUNT_NAME="Night Shift Events"
WHISH_PHONE="+961 00 000 000"

# Seed accounts (CHANGE before any real use).
SEED_ADMIN_EMAIL="admin@nightshift.local"
SEED_ADMIN_PASSWORD="nightshift-admin"
SEED_SCANNER_EMAIL="door@nightshift.local"
SEED_SCANNER_PASSWORD="nightshift-scan"

# Enables the dev clock (time travel) on /admin/trace. Never set in production.
DEV_TOOLS=1

# ---- Email ----
# console = print emails to the server log (default, sends nothing)
# Local testing with Mailpit (winget install axllent.mailpit; run `mailpit`):
#   EMAIL_PROVIDER=smtp, SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_USER/SMTP_PASS empty. Inbox: http://localhost:8025
# smtp    = really send. Resend (your own domain, recommended):
#   1. resend.com > Domains > Add domain, then add the DNS records it shows (SPF, DKIM, MX) at your
#      registrar and wait for "Verified". Add a DMARC record too: TXT _dmarc  "v=DMARC1; p=none;"
#   2. resend.com > API Keys > Create, permission "Sending access", limited to that domain
#   3. Fill in below. SMTP_USER is literally the word resend; SMTP_PASS is the API key (re_...).
#   (Gmail instead: SMTP_HOST=smtp.gmail.com, SMTP_USER=<gmail address>, SMTP_PASS=<app password>.)
# Worker deployment uses EMAIL_PROVIDER=resend and RESEND_API_KEY.
RESEND_API_KEY=
EMAIL_PROVIDER=console
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
# Must be an address on the verified domain, e.g. "Night Shift <tickets@yourdomain.com>"
EMAIL_FROM=
# Where buyer replies go (Reply-To) and the address shown in emails. Defaults to the EMAIL_FROM address.
SUPPORT_EMAIL=

# Set to 1 ONLY when running behind a reverse proxy you control (nginx, Render, Railway...),
# so rate limits use the real client IP from X-Forwarded-For. Without a proxy, leave it off:
# clients could otherwise fake their IP and dodge every limit.
TRUST_PROXY=0
