{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "night-shift",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./dist/assets", "binding": "ASSETS", "run_worker_first": true },
  "build": { "command": "node scripts/build-assets.mjs" },
  "vars": {
    "NODE_ENV": "production",
    "CF_WORKER": "1",
    "DEV_TOOLS": "0",
    "APP_URL": "https://night-shift.elieboutros.dev",
    "SUPABASE_URL": "https://jfmfmwslkkxfcbwijnxa.supabase.co",
    "EMAIL_PROVIDER": "resend"
  }
}
