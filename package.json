{
  "name": "night-shift",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "build": "node scripts/build-assets.mjs && wrangler deploy --dry-run --outdir dist/worker",
    "deploy": "wrangler deploy",
    "dev:worker": "wrangler dev",
    "prestart": "node scripts/build-assets.mjs",
    "predev": "node scripts/build-assets.mjs",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts"
  },
  "description": "Night Shift ticketing - minimal UI, function first",
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@hono/node-server": "2.1.6",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "html5-qrcode": "2.3.8",
    "jose": "6.2.16",
    "nodemailer": "10.3.1",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "drizzle-kit": "0.31.11",
    "ts-morph": "28.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.159.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
